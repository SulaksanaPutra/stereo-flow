{
  "manifest_version": 3,
  "name": "StereoFlow",
  "version": "1.1.0",
  "description": "Adjust audio balance (left/right panning), volume amplification, and mono audio independently for each tab.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StereoFlow"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116"
}
